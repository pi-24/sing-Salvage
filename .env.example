# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible endpoint used by src/llm.js for ingest, questions, drafts
# and translation. Leave blank when MOCK=1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: separate model for the photo ingest step. Defaults to LLM_MODEL.
LLM_VISION_MODEL=

# 1 = serve canned responses from data/mock_responses/ (no credits, no network).
# 0 = call the model.
MOCK=1

PORT=3000
DB_PATH=./salvagescribe.sqlite
